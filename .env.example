# All NEXT_PUBLIC_* values are included in the browser bundle. Never put private
# keys, signing secrets, backend credentials, or unrestricted API keys here.
# Local backend; run this frontend on port 3001 (see README).
NEXT_PUBLIC_API_URL=http://localhost:3000

# WalletConnect Project ID (get from cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id

# Base mainnet RPC. A provider key here must be intended for public browser use.
# The supported chains are configured in src/config/wagmi.ts.
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org

# Contract Addresses (Base Mainnet)
NEXT_PUBLIC_BLOC_TOKEN_ADDRESS=0x022c6cb9Fd69A99cF030cB43e3c28BF82bF68Fe9
NEXT_PUBLIC_ARCADE_VAULT_ADDRESS=0x04bA29B0aD6bAcFA0236Fce688a7536ADfc5F17B
NEXT_PUBLIC_STAKING_POOL_ADDRESS=0xa3465cfD544c6B11C3BBeD5203AEC739976059D4
NEXT_PUBLIC_YEET_ENGINE_ADDRESS=0xcD4ac644DB51455d736E0e3aE416C3c373185e48
NEXT_PUBLIC_TIP_BOT_ADDRESS=0xAAc499D71F642F134AdC699b3f11572163A7FD3E
NEXT_PUBLIC_POOL_PAYOUT_ADDRESS=0xb440AE06aC5ceF3Eb837FDF353459Fb8eFF3556d
